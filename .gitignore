# Python
__pycache__/
*.py[cod]
*$py.class
*.so
!tests/fixtures/**/*.so
.Python
*.egg-info/
.installed.cfg
*.egg
build/
dist/
.eggs/
# uv writes a lockfile when run in the project root; this tool is distributed via pyproject
# and does not track a lock — ignore the generated artifact so it never lands in a commit.
uv.lock

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
coverage.xml

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Project-specific - never commit
workspaces/
internal_data/
*.db
*.db-shm
*.db-wal
.env
.env.local

# Benchmark firmware (only ground_truth files are tracked)
benchmarks/raw_firmware/
benchmarks/extracted/

# Logs
*.log
logs/
# Private content — never commit to public repo
internal/
private/
.notes/
SECRETS.md
TODO-PRIVATE.md
*-PRIVATE.md
*.private.*

# Local-only full vendor denylist (brand names must not be committed)
.githooks/vendor-watchlist.txt
