{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.JoeyZzZzZz/treasure-map",
  "title": "Treasure Map",
  "description": "Firmware attack-surface map and patch diff for AI agents. Requires tmap init (Ghidra toolchain).",
  "websiteUrl": "https://tmap.tools/",
  "icons": [
    {
      "src": "https://tmap.tools/favicon-32.png",
      "mimeType": "image/png",
      "sizes": ["32x32"]
    },
    {
      "src": "https://tmap.tools/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": ["180x180"]
    }
  ],
  "repository": {
    "url": "https://github.com/JoeyZzZzZz/treasure-map",
    "source": "github"
  },
  "version": "0.2.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "tmap-agents",
      "version": "0.2.1",
      "runtimeHint": "uvx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
