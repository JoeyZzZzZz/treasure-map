#!/usr/bin/env bash
SENSITIVE=$(git diff --cached --name-only | grep -E "^internal/|^private/|^\.notes/|\.private\.|SECRETS\.|-PRIVATE\.")
if [ -n "$SENSITIVE" ]; then
    echo ""
    echo "❌ COMMIT BLOCKED — sensitive paths in staged changes:"
    echo ""
    echo "$SENSITIVE" | sed 's/^/  /'
    echo ""
    echo "If genuinely intentional:  git commit --no-verify"
    echo ""
    exit 1
fi

# ── §5.5 vendor-neutrality enforcement ───────────────────────────────────────
# Resolve watchlist: env override → local notes dir → local repo copy → example.
WATCHLIST=""
for cand in "$TM_VENDOR_WATCHLIST" \
            "$HOME/treasure-map-notes/vendor-watchlist.txt" \
            ".githooks/vendor-watchlist.txt" \
            ".githooks/vendor-watchlist.example.txt"; do
    if [ -n "$cand" ] && [ -f "$cand" ]; then WATCHLIST="$cand"; break; fi
done
if [ "$WATCHLIST" = ".githooks/vendor-watchlist.example.txt" ]; then
    echo "ℹ️  vendor watchlist: using brand-free example (regex patterns only)."
    echo "    Install the full local list at ~/treasure-map-notes/vendor-watchlist.txt"
    echo "    (or set TM_VENDOR_WATCHLIST) for complete brand-name coverage."
fi
if [ -f "$WATCHLIST" ]; then
    ADDED=$(git diff --cached -U0 --diff-filter=ACM -- . \
            ":(exclude).githooks/vendor-watchlist.txt" \
            ":(exclude).githooks/vendor-watchlist.example.txt" \
            ":(exclude).githooks/pre-commit" \
            | grep '^+' | grep -v '^+++' || true)
    if [ -n "$ADDED" ]; then
        HITS=""
        while IFS= read -r pat; do
            case "$pat" in ''|\#*) continue ;; esac
            # Regex patterns (starting with [ or () use PCRE case-sensitive matching
            # so that [A-Z]{2,4}-... only fires on UPPERCASE model numbers with
            # digits (lookahead in pattern), not on words like "non-binary".
            # Literal name patterns use -w (whole-word, case-insensitive) to avoid
            # substring matches (e.g. "Ring" must not match "string").
            case "$pat" in
                \[*|\(*) MATCH=$(printf '%s\n' "$ADDED" | grep -P -- "$pat" || true) ;;
                *)        MATCH=$(printf '%s\n' "$ADDED" | grep -iwE -- "$pat" || true) ;;
            esac
            if [ -n "$MATCH" ]; then
                HITS="${HITS}"$'\n'"  pattern: ${pat}"$'\n'"$(printf '%s' "$MATCH" | sed 's/^/    /')"
            fi
        done < "$WATCHLIST"
        if [ -n "$HITS" ]; then
            echo ""
            echo "❌ COMMIT BLOCKED — vendor identifier(s) in staged changes (§5.5):"
            echo "$HITS"
            echo ""
            echo "Vendor names / model numbers must never enter committed artifacts."
            echo "Fix: replace with a generic category term (e.g. 'IoT camera',"
            echo "'consumer router', 'main web daemon'), re-stage, and retry."
            echo "Bypassing this check is not authorized."
            echo ""
            exit 1
        fi
    fi
fi
