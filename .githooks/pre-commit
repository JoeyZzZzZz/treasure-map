#!/usr/bin/env bash
# Shared detection logic lives in .githooks/lib.sh (also used by commit-msg + CI).
HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/lib.sh"

SENSITIVE=$(git diff --cached --name-only | grep -E "^internal/|^private/|^\.notes/|\.private\.|SECRETS\.|-PRIVATE\.")
if [ -n "$SENSITIVE" ]; then
    echo ""
    echo "❌ COMMIT BLOCKED — sensitive paths in staged changes:"
    echo ""
    echo "$SENSITIVE" | sed 's/^/  /'
    echo ""
    echo "If genuinely intentional:  git commit --no-verify"
    echo ""
    exit 1
fi

# ── vendor-neutrality enforcement (diff content) ─────────────────────────────
# Resolve the watchlist and scan the staged ADDED lines via the shared scanner.
# ADDED_ALL drops only the pattern-holding machinery (TM_DIFF_MACHINERY_EXCLUDES
# in lib.sh); the neutrality tests stay IN — they must never name a brand.
WATCHLIST="$(tm_resolve_watchlist || true)"
if [ -n "$WATCHLIST" ]; then
    ADDED_ALL=$(git diff --cached -U0 --diff-filter=ACM -- . \
            "${TM_DIFF_MACHINERY_EXCLUDES[@]}" \
            | grep '^+' | grep -v '^+++' || true)
    if HITS=$(printf '%s' "$ADDED_ALL" | tm_scan_text "$WATCHLIST"); then
        :
    else
        echo ""
        echo "❌ COMMIT BLOCKED — vendor identifier(s) in staged changes:"
        echo "$HITS"
        echo ""
        echo "Vendor names / model numbers must never enter committed artifacts."
        echo "Fix: replace with a generic category term (e.g. 'IoT camera',"
        echo "'consumer router', 'main web daemon'), re-stage, and retry."
        echo "Bypassing this check is not authorized."
        echo ""
        exit 1
    fi
fi

# ── strategy/judgment-vocabulary guard (added lines, whole tree) ──────────────
# Mirror the CI backstop (scripts/check-vendor-neutrality.sh): scan ADDED lines
# across the whole tree, minus the pattern-holding machinery AND the self-
# referential neutrality tests (which embed this vocab as denylist literals). Same
# view CI uses, so a stray banned word — in a test file too, not just src — is
# caught here at commit time instead of one CI round-trip later.
ADDED_FRAMING=$(git diff --cached -U0 --diff-filter=ACM -- . \
        "${TM_DIFF_MACHINERY_EXCLUDES[@]}" "${TM_DIFF_NEUTRALITY_TEST_EXCLUDES[@]}" \
        | grep '^+' | grep -v '^+++' || true)
HITS=$(printf '%s' "$ADDED_FRAMING" | grep -nIE "$TM_BANNED_VOCAB" || true)
if [ -n "$HITS" ]; then
  echo ""
  echo "❌ COMMIT BLOCKED — strategy/judgment vocabulary in staged changes:"
  echo "$HITS"
  echo ""
  echo "Use mechanism-only naming; keep strategy framing out of committed code."
  echo ""
  exit 1
fi

# ── private-document / private-path guard ────────────────────────────────────
# Committed code, docs, and hooks must stand on their own — never point at a
# private document or name a private path. The hook excludes itself (its pattern
# definition would otherwise self-match).
HITS=$(git diff --cached --name-only --diff-filter=ACM \
        -- 'src/*' 'docs/*' '*.md' '.githooks/*' 'CONTRIBUTING.md' \
           ':!LICENSE' ':!.githooks/pre-commit' ':!.githooks/commit-msg' ':!.githooks/lib.sh' \
       | xargs grep -nIE "$TM_PRIVDOC" 2>/dev/null || true)
if [ -n "$HITS" ]; then
  echo ""
  echo "❌ COMMIT BLOCKED — committed artifacts must not reference private docs/paths:"
  echo "$HITS"
  echo ""
  echo "State the mechanism inline; do not name private notes, private paths, or doc sections."
  echo ""
  exit 1
fi

# ── private-doc section-citation guard ───────────────────────────────────────
# Committed code must be self-contained — no private-doc section/design-code refs
# (§x.x, PRD §, DD/ED/FD codes). Excludes the guard machinery (.githooks/* and the
# hook's own test) whose denylists must contain the very tokens they detect.
HITS=$(git diff --cached --name-only --diff-filter=ACM \
        -- 'src/*' 'docs/*' '*.md' ':!LICENSE' ':!.githooks/*' \
           ':!tests/unit/test_precommit_hook.py' \
       | xargs grep -nIE "$TM_SECTREF" 2>/dev/null || true)
if [ -n "$HITS" ]; then
  echo ""
  echo "❌ COMMIT BLOCKED — committed code must be self-contained — no private-doc/section refs:"
  echo "$HITS"
  echo ""
  echo "State the mechanism inline; drop the citation (no §x.x / PRD § / DD-ED-FD codes)."
  echo ""
  exit 1
fi
